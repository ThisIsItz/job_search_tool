# Copy to .env and fill in what you need (this file is loaded by app/main.py
# and app/ai_evaluate.py via python-dotenv). .env itself is gitignored.

# Required only for the AI evaluation step (app/ai_evaluate.py).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default model (claude-haiku-4-5) used for scoring.
# ANTHROPIC_MODEL=claude-haiku-4-5

# Required only for the AI filter step (app/ai_filter.py).
# Free key at https://aistudio.google.com
GEMINI_API_KEY=

# Required only for Telegram notifications (app/notify_telegram.py, `make daily`).
# Create a bot with @BotFather; get the chat id with
# `python -m app.notify_telegram --find-chat-id` after messaging the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required only if you enable an Adzuna entry in aggregators.yaml.
# Free signup at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
